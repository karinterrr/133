/* ============================================================
 *  Pixel Gold Miner  --  Windows console game in plain C
 *
 *  Environment : Visual Studio 2026
 *  How to use  : File > New > Project > "Console App" (or "Empty
 *                Project"), add this file, press F5 / Ctrl+F5.
 *                Do NOT pick "Windows Desktop Application" --
 *                that template expects WinMain and fails LNK2019.
 *
 *  Controls    : SPACE or DOWN  -> drop the hook
 *                R             -> restart after game over
 *                ESC           -> quit
 *
 *  Rules       : The hook swings like a pendulum. Drop it and it
 *                grabs whatever it touches, then hauls back. Heavier
 *                loads haul back slower. Reach the level target
 *                before the clock runs out or it is game over.
 *
 *  Rendering   : a char grid plus a colour grid are painted each
 *                frame, then emitted as one ANSI true-colour blob.
 *                A colour escape is only emitted when the colour
 *                actually changes, which keeps the output small.
 *
 *  NOTE: this file is deliberately pure ASCII. Chinese comments in a
 *  UTF-8-without-BOM file make MSVC (which defaults to code page
 *  936) mis-decode the bytes and emit C2001 / C4819.
 * ============================================================ */
#define _CRT_SECURE_NO_WARNINGS

#include <windows.h>
#include <stdio.h>
#include <stdlib.h>
#include <stdarg.h>
#include <string.h>
#include <math.h>

/* GetAsyncKeyState lives in user32. The pragma saves you from having
 * to add user32.lib by hand under Project > Properties > Linker. */
#pragma comment(lib, "user32.lib")

#ifndef M_PI
#define M_PI 3.14159265358979323846
#endif

/* ---------------- tuning ---------------- */
#define FRAME_MS        16      /* ~60 fps target                        */
#define MAX_OBJS        40
#define MAX_DT          (1.0 / 30.0)

#define MINER_W         5
#define MINER_H         3
#define MINER_Y         2       /* top row of the miner sprite           */

#define LEVEL_TIME      45.0    /* seconds per level                     */
#define TARGET_BASE     350
#define TARGET_STEP     250

#define SWING_AMP       (70.0 * M_PI / 180.0)
#define SWING_BASE      1.50    /* rad/s, rises a little per level       */
#define SWING_MAX       2.20
#define SHOOT_SPEED     55.0    /* cells/s going out                     */
#define PULL_EMPTY      90.0    /* cells/s coming back with nothing      */
#define PULL_BASE       55.0    /* divided by (0.6 + load weight)        */

#define HOOK_SWING      0
#define HOOK_SHOOT      1
#define HOOK_PULL       2

#define STATE_PLAY      0
#define STATE_OVER      1

/* A gem is reachable when the angle from the origin to the gem is
 * within SWING_AMP of straight down AND the gem is no further than the
 * rope can extend. Anything else can never be grabbed, and a gem that
 * can never be grabbed just wastes the player's clock.
 *
 * REACH_MARGIN is subtracted from SWING_AMP so a gem never sits right
 * at the extreme of the swing, where a single frame step can overshoot
 * it. */
#define REACH_MARGIN    (6.0 * M_PI / 180.0)
#define MINE_TOP_GAP    5       /* first usable row is origin_y + this  */

/* ---------------- palette ---------------- */
enum {
    COL_BG = 0,
    COL_HUD,
    COL_ROPE,
    COL_MINER,
    COL_DIAMOND,
    COL_GOLD_L,
    COL_GOLD_S,
    COL_ROCK,
    COL_HOOK,
    COL_WARN,
    COL_WHITE,
    COL_COUNT
};

/* COL_BG is an empty string: those cells only ever hold spaces, so
 * skipping the escape saves a lot of bytes every frame. */
static const char *const COL_SEQ[COL_COUNT] = {
    "",
    "\x1b[38;2;200;205;215m",
    "\x1b[38;2;170;130;90m",
    "\x1b[38;2;235;205;165m",
    "\x1b[38;2;120;240;255m",
    "\x1b[38;2;255;215;60m",
    "\x1b[38;2;225;165;50m",
    "\x1b[38;2;130;130;140m",
    "\x1b[38;2;240;240;240m",
    "\x1b[38;2;255;80;80m",
    "\x1b[38;2;255;255;255m"
};

/* ---------------- object kinds ---------------- */
enum { TYPE_DIAMOND = 0, TYPE_GOLD_L, TYPE_GOLD_S, TYPE_ROCK, TYPE_COUNT };

static const int    OBJ_VALUE [TYPE_COUNT] = { 300, 150,  60,  15 };
static const double OBJ_WEIGHT[TYPE_COUNT] = { 0.5, 2.2, 1.0, 3.0 };
static const char   OBJ_GLYPH [TYPE_COUNT] = { '*',  '@',  'o',  '#' };
static const int    OBJ_COLOR [TYPE_COUNT] = {
    COL_DIAMOND, COL_GOLD_L, COL_GOLD_S, COL_ROCK
};

typedef const char (*SpriteArt)[MINER_W + 1];

/* Miner, facing the player, holding the rope. */
static const char MINER_ART[MINER_H][MINER_W + 1] = {
    "  o  ",
    " /|\\ ",
    "  ^  "
};

/* ---------------- entities ---------------- */
typedef struct {
    double x, y;
    int    type;
    int    active;
} Obj;

typedef struct {
    double len;         /* rope length in cells                     */
    double angle;       /* PI/2 is straight down                    */
    double swing;       /* offset from straight down, radians       */
    int    dir;         /* +1 / -1, direction of the swing          */
    int    state;
    int    carry_type;  /* -1 when the hook is empty                */
} Hook;

static Obj  g_objs[MAX_OBJS];
static Hook g_hook;

static double g_origin_x, g_origin_y, g_hook_max;
static double g_score, g_earned, g_target, g_time_left, g_swing_speed;
static int    g_level, g_state;
static double g_banner_t;
static char   g_banner[64];

/* ---------------- screen buffers ---------------- */
static int             g_cols, g_rows;
static char           *g_glyph;
static unsigned char  *g_col;
static char           *g_out;
static size_t          g_outcap;
static unsigned char   g_prev_key[256];

/* =================================================================
 *  Small helpers
 * ================================================================= */
static double rand01(void)
{
    return (double)rand() / ((double)RAND_MAX + 1.0);
}
static double rand_range(double lo, double hi)
{
    return lo + rand01() * (hi - lo);
}

static int key_down(int vk)
{
    return (GetAsyncKeyState(vk) & 0x8000) != 0;
}

/* Edge-triggered: true only on the frame the key goes down. Call it
 * exactly once per frame per watched key, otherwise the stored
 * previous state drifts out of sync. */
static int key_pressed(int vk)
{
    int idx  = vk & 0xFF;
    int down = key_down(vk);
    int was  = g_prev_key[idx];
    g_prev_key[idx] = (unsigned char)(down ? 1 : 0);
    return down && !was;
}

/* ---------------- bounds-checked append ---------------- */
static size_t app(char *buf, size_t cap, size_t n, const char *fmt, ...)
{
    va_list ap;
    int     wrote;
    size_t  room;

    if (n >= cap)
        return cap;
    room = cap - n;

    va_start(ap, fmt);
    wrote = vsnprintf(buf + n, room, fmt, ap);
    va_end(ap);

    if (wrote < 0)                /* encoding error: stop appending */
        return cap;
    if ((size_t)wrote >= room)    /* truncated: flag the buffer full */
        return cap;
    return n + (size_t)wrote;
}

/* ---------------- painting ---------------- */
static void put(int x, int y, int ch, int col)
{
    if (x < 0 || x >= g_cols || y < 0 || y >= g_rows)
        return;
    g_glyph[(size_t)y * g_cols + x] = (char)ch;
    g_col[(size_t)y * g_cols + x]   = (unsigned char)col;
}

/* Spaces in the art are transparent, so sprites overlay cleanly. */
static void put_sprite(int x, int y, SpriteArt art, int col)
{
    int r, c;
    for (r = 0; r < MINER_H; r++)
        for (c = 0; c < MINER_W; c++)
            if (art[r][c] != ' ')
                put(x + c, y + r, (unsigned char)art[r][c], col);
}

static void put_text(int x, int y, const char *s, int col)
{
    int i;
    for (i = 0; s[i] != '\0'; i++)
        put(x + i, y, (unsigned char)s[i], col);
}

static void put_text_centered(int y, const char *s, int col)
{
    put_text((g_cols - (int)strlen(s)) / 2, y, s, col);
}

static void clear_scene(void)
{
    memset(g_glyph, ' ', (size_t)g_cols * g_rows);
    memset(g_col, COL_BG, (size_t)g_cols * g_rows);
}

/* Rope: walk the line and pick a character from the local slope, so
 * it reads as a real rope rather than a row of dots. */
static void draw_rope(double ox, double oy, double hx, double hy)
{
    double dx = hx - ox, dy = hy - oy;
    double adx = fabs(dx), ady = fabs(dy);
    double len = sqrt(dx * dx + dy * dy);
    int    ch, steps, s;

    if (adx > ady * 2.0)       ch = '-';
    else if (ady > adx * 2.0)  ch = '|';
    else                       ch = (dx * dy > 0.0) ? '\\' : '/';

    steps = (int)(len * 2.0);
    if (steps < 1) steps = 1;

    for (s = 0; s <= steps; s++) {
        double f = (double)s / (double)steps;
        put((int)floor(ox + dx * f + 0.5),
            (int)floor(oy + dy * f + 0.5), ch, COL_ROPE);
    }
}

/* =================================================================
 *  Console plumbing
 * ================================================================= */
static int enable_vt(HANDLE h)
{
    DWORD mode;
    if (!GetConsoleMode(h, &mode))
        return 0;
    return SetConsoleMode(h, mode | ENABLE_VIRTUAL_TERMINAL_PROCESSING) != 0;
}

static void show_cursor(HANDLE h, int visible)
{
    CONSOLE_CURSOR_INFO ci;
    if (GetConsoleCursorInfo(h, &ci)) {
        ci.bVisible = visible ? TRUE : FALSE;
        SetConsoleCursorInfo(h, &ci);
    }
}

/* Allocate the new buffers before releasing the old ones, so a failed
 * allocation leaves the previous, working set intact. */
static int alloc_buffers(int cols, int rows)
{
    size_t         cells = (size_t)cols * (size_t)rows;
    size_t         cap   = cells * 32 + (size_t)rows * 16 + 64;
    char          *g = (char *)malloc(cells);
    unsigned char *c = (unsigned char *)malloc(cells);
    char          *o = (char *)malloc(cap);

    if (g == NULL || c == NULL || o == NULL) {
        free(g); free(c); free(o);
        return 0;
    }
    free(g_glyph); free(g_col); free(g_out);
    g_glyph = g; g_col = c; g_out = o;
    g_outcap = cap; g_cols = cols; g_rows = rows;
    return 1;
}

/* Returns 0 when the window is too small to host the game. */
static int sync_size(HANDLE out)
{
    CONSOLE_SCREEN_BUFFER_INFO csbi;
    int cols, rows;

    if (!GetConsoleScreenBufferInfo(out, &csbi))
        return 0;

    /* Drop the last column and row so a full-width write can never
     * wrap onto the next line and scroll the whole window. */
    cols = csbi.srWindow.Right  - csbi.srWindow.Left + 1 - 1;
    rows = csbi.srWindow.Bottom - csbi.srWindow.Top  + 1 - 1;
    if (cols < 40 || rows < 18)
        return 0;

    if (cols != g_cols || rows != g_rows)
        return alloc_buffers(cols, rows);
    return 1;
}

static void flush_frame(void)
{
    size_t n = 0;
    int    last = -1, x, y, full = 0;

    for (y = 0; y < g_rows && !full; y++) {
        n = app(g_out, g_outcap, n, "\x1b[%d;1H", y + 1);
        for (x = 0; x < g_cols; x++) {
            int c = g_col[(size_t)y * g_cols + x];
            if (c != last) {
                n = app(g_out, g_outcap, n, "%s", COL_SEQ[c]);
                last = c;
            }
            if (n < g_outcap)
                g_out[n++] = g_glyph[(size_t)y * g_cols + x];
            else {
                full = 1;
                break;
            }
        }
        if (n >= g_outcap)
            full = 1;
    }
    n = app(g_out, g_outcap, n, "\x1b[0m");

    fwrite(g_out, 1, n, stdout);
    fflush(stdout);
}

/* =================================================================
 *  Geometry helpers
 * ================================================================= */
static void hook_pos(double *hx, double *hy)
{
    *hx = g_origin_x + cos(g_hook.angle) * g_hook.len;
    *hy = g_origin_y + sin(g_hook.angle) * g_hook.len;
}

/* Nearest grabbable object, or -1.
 *
 * Checks the hook's own cell plus its eight neighbours rather than the
 * single cell it sits on. The hook swings in discrete frame steps, and
 * at long range one step moves the tip further than an object is wide:
 * at a rope length of 45 cells a 1/60 s step sweeps about 1.1 cells,
 * so a single-cell test would let rays step straight over a gem in the
 * far corners. The neighbourhood makes grabbing forgiving instead. */
static int find_grab(double x, double y)
{
    int    cx = (int)floor(x + 0.5);
    int    cy = (int)floor(y + 0.5);
    int    i, best = -1;
    double bestd = 1.0e9;

    for (i = 0; i < MAX_OBJS; i++) {
        int    dx, dy;
        double d;

        if (!g_objs[i].active)
            continue;

        dx = (int)g_objs[i].x - cx;
        dy = (int)g_objs[i].y - cy;
        if (dx < -1 || dx > 1 || dy < -1 || dy > 1)
            continue;

        d = (double)(dx * dx + dy * dy);
        if (d < bestd) {
            bestd = d;
            best  = i;
        }
    }
    return best;
}

static void recompute_origin(void)
{
    double dy, dx2, d1, d2;

    g_origin_x = floor(g_cols / 2.0);
    g_origin_y = (double)(MINER_Y + MINER_H);

    /* Longest rope we could ever need: origin to either bottom corner.
     * d2 is also declared here, not inside the block below, because it
     * is read on the next line. */
    dy  = (double)(g_rows - 2) - g_origin_y;
    dx2 = (double)(g_cols - 2) - g_origin_x;

    d1 = sqrt(g_origin_x * g_origin_x + dy * dy);
    d2 = sqrt(dx2 * dx2 + dy * dy);

    g_hook_max = ((d1 > d2) ? d1 : d2) + 2.0;
}

/* =================================================================
 *  Level setup
 * ================================================================= */
static int pick_type(void)
{
    double r = rand01();
    if (r < 0.08) return TYPE_DIAMOND;
    if (r < 0.33) return TYPE_GOLD_L;
    if (r < 0.70) return TYPE_GOLD_S;
    return TYPE_ROCK;
}

/* Chebyshev distance keeps objects from clumping into one blob. */
static int too_close(double x, double y)
{
    int i;
    for (i = 0; i < MAX_OBJS; i++) {
        double dx, dy;
        if (!g_objs[i].active)
            continue;
        dx = g_objs[i].x - x;
        dy = g_objs[i].y - y;
        if (dx < 0) dx = -dx;
        if (dy < 0) dy = -dy;
        if (dx < 3.0 && dy < 3.0)
            return 1;
    }
    return 0;
}

/* Can a gem sitting at cell (x, y) be reached by the swinging hook?
 * The hook is a ray from the origin; a gem is reachable when the angle
 * to it is inside the swing cone and its distance is inside the rope. */
static int reachable(double x, double y)
{
    double dx = x - g_origin_x;
    double dy = y - g_origin_y;
    double dist, ang;

    if (dy <= 0.0)                    /* above the pivot: behind the miner */
        return 0;

    dist = sqrt(dx * dx + dy * dy);
    if (dist > g_hook_max)
        return 0;

    /* Angle away from straight down. atan2(dx, dy) is 0 when the gem is
     * directly below and grows toward +/-pi/2 at the horizontal. */
    ang = atan2(dx, dy);
    if (ang < 0.0) ang = -ang;
    return ang <= SWING_AMP - REACH_MARGIN;
}

static void place_objects(void)
{
    int i, tries;

    for (i = 0; i < MAX_OBJS; i++)
        g_objs[i].active = 0;

    for (i = 0; i < MAX_OBJS; i++) {
        int placed = 0;

        for (tries = 0; tries < 90 && !placed; tries++) {
            double x = rand_range(1.0, (double)(g_cols - 2));
            double y = rand_range(g_origin_y + MINE_TOP_GAP,
                                  (double)(g_rows - 2));

            if (!reachable(floor(x + 0.5), floor(y + 0.5))) continue;
            if (too_close(x, y)) continue;

            g_objs[i].x      = floor(x + 0.5);
            g_objs[i].y      = floor(y + 0.5);
            g_objs[i].type   = pick_type();
            g_objs[i].active = 1;
            placed = 1;
        }
        if (!placed)
            break;      /* field is full: fewer objects than asked for */
    }
}

static void start_level(void)
{
    g_time_left   = LEVEL_TIME;
    g_earned      = 0.0;
    g_target      = (double)(TARGET_BASE + (g_level - 1) * TARGET_STEP);

    g_swing_speed = SWING_BASE + (g_level - 1) * 0.06;
    if (g_swing_speed > SWING_MAX) g_swing_speed = SWING_MAX;

    place_objects();

    g_hook.len        = 0.0;
    g_hook.swing      = 0.0;
    g_hook.dir        = 1;
    g_hook.state      = HOOK_SWING;
    g_hook.carry_type = -1;
    g_hook.angle      = M_PI / 2.0;

    snprintf(g_banner, sizeof(g_banner), "LEVEL %d   TARGET %d",
             g_level, (int)g_target);
    g_banner_t = 1.8;
}

static void reset_game(void)
{
    g_level = 1;
    g_score = 0.0;
    g_state = STATE_PLAY;
    start_level();
}

/* =================================================================
 *  Hook
 * ================================================================= */
static void deliver(void)
{
    if (g_hook.carry_type < 0)
        return;
    g_score  += OBJ_VALUE[g_hook.carry_type];
    g_earned += OBJ_VALUE[g_hook.carry_type];
    g_hook.carry_type = -1;
}

static void update_hook(double dt)
{
    if (g_hook.state == HOOK_SWING) {
        g_hook.swing += g_swing_speed * (double)g_hook.dir * dt;
        if (g_hook.swing > SWING_AMP) {
            g_hook.swing = SWING_AMP;
            g_hook.dir = -1;
        }
        if (g_hook.swing < -SWING_AMP) {
            g_hook.swing = -SWING_AMP;
            g_hook.dir = 1;
        }
        g_hook.angle = M_PI / 2.0 + g_hook.swing;
        return;
    }

    if (g_hook.state == HOOK_SHOOT) {
        double ox, oy, nx, ny, sdx, sdy, sdist;
        int    steps, k, idx = -1;

        hook_pos(&ox, &oy);                  /* tip before this step */
        g_hook.len += SHOOT_SPEED * dt;
        hook_pos(&nx, &ny);                  /* tip after this step  */

        /* Sweep the whole segment the tip covered this frame instead of
         * only testing where it ended up.
         *
         * At 55 cells/s and 60 fps a single step advances about 0.92
         * cells -- almost a full cell. Testing only the endpoint let the
         * tip step clean over a gem: a grazing shot lands the endpoint
         * just past the capture region, so the rope visibly passes
         * through the diamond and still misses it. Measured effect was
         * a 4.5% grab rate on shots that were geometrically dead on.
         *
         * Sub-stepping at 0.35 cells keeps every capture region on the
         * path under test. */
        sdx   = nx - ox;
        sdy   = ny - oy;
        sdist = sqrt(sdx * sdx + sdy * sdy);
        steps = (int)(sdist / 0.35) + 1;
        for (k = 0; k <= steps; k++) {
            double f = (double)k / (double)steps;
            idx = find_grab(ox + sdx * f, oy + sdy * f);
            if (idx >= 0)
                break;
        }

        if (idx >= 0) {
            g_hook.carry_type  = g_objs[idx].type;
            g_objs[idx].active = 0;
            g_hook.state       = HOOK_PULL;
            return;
        }

        /* Nothing on the way: reel back in if we ran out of rope or
         * left the screen. */
        if (g_hook.len >= g_hook_max ||
            nx < 0.0 || nx > (double)(g_cols - 1) ||
            ny < 0.0 || ny > (double)(g_rows - 1)) {
            g_hook.state = HOOK_PULL;
        }
        return;
    }

    /* HOOK_PULL */
    {
        double weight = (g_hook.carry_type >= 0)
                      ? OBJ_WEIGHT[g_hook.carry_type] : 0.0;
        double speed  = (weight <= 0.0)
                      ? PULL_EMPTY
                      : PULL_BASE / (0.6 + weight);

        g_hook.len -= speed * dt;
        if (g_hook.len <= 0.0) {
            g_hook.len = 0.0;
            deliver();
            g_hook.state = HOOK_SWING;
        }
    }
}

/* =================================================================
 *  Update
 * ================================================================= */
static void update(double dt)
{
    if (g_banner_t > 0.0)
        g_banner_t -= dt;

    g_time_left -= dt;
    update_hook(dt);

    if (g_time_left <= 0.0) {
        g_time_left = 0.0;

        /* A load already on the hook still counts -- time running out
         * mid-haul should not silently delete points. */
        deliver();

        if (g_earned >= g_target) {
            g_level++;
            start_level();
        } else {
            g_state = STATE_OVER;
        }
    }
}

/* =================================================================
 *  Render
 * ================================================================= */
static void render(void)
{
    int    i;
    double hx, hy;
    char   left[128];
    char   timebuf[32];

    clear_scene();

    /* objects */
    for (i = 0; i < MAX_OBJS; i++) {
        if (!g_objs[i].active)
            continue;
        put((int)g_objs[i].x, (int)g_objs[i].y,
            OBJ_GLYPH[g_objs[i].type], OBJ_COLOR[g_objs[i].type]);
    }

    /* miner */
    put_sprite((int)g_origin_x - MINER_W / 2, MINER_Y, MINER_ART, COL_MINER);

    /* rope, then hook on top */
    hook_pos(&hx, &hy);
    draw_rope(g_origin_x, g_origin_y, hx, hy);

    if (g_hook.carry_type >= 0)
        put((int)floor(hx + 0.5), (int)floor(hy + 0.5),
            OBJ_GLYPH[g_hook.carry_type], OBJ_COLOR[g_hook.carry_type]);
    else
        put((int)floor(hx + 0.5), (int)floor(hy + 0.5), 'v', COL_HOOK);

    /* ---- HUD ---- */
    {
        int tl = (int)ceil(g_time_left);
        if (tl < 0) tl = 0;

        snprintf(left, sizeof(left),
                 " SCORE %05d   LV %d   EARN %d/%d   TIME ",
                 (int)g_score, g_level, (int)g_earned, (int)g_target);
        put_text(0, 0, left, COL_HUD);

        snprintf(timebuf, sizeof(timebuf), "%d:%02d ", tl / 60, tl % 60);
        put_text((int)strlen(left), 0, timebuf,
                 (tl <= 10) ? COL_WARN : COL_HUD);
    }

    /* ---- banner ---- */
    if (g_banner_t > 0.0 && g_state == STATE_PLAY)
        put_text_centered(g_rows / 2 - 1, g_banner, COL_WHITE);

    /* ---- game over ---- */
    if (g_state == STATE_OVER) {
        int y = g_rows / 2 - 2, x, r;
        char line[64];

        for (x = 0; x < g_cols; x++)
            for (r = 0; r < 5; r++)
                put(x, y + r, ' ', COL_BG);

        put_text_centered(y + 0, "  T I M E   U P  ", COL_WARN);
        snprintf(line, sizeof(line), "SCORE %05d   LEVEL %d",
                 (int)g_score, g_level);
        put_text_centered(y + 2, line, COL_WHITE);
        put_text_centered(y + 3, "R RESTART   ESC QUIT", COL_HUD);
    }
}

/* =================================================================
 *  Startup self-checks. These catch mistakes that would otherwise show
 *  up only as a silently broken game.
 * ================================================================= */
static int sprites_ok(void)
{
    int r;
    for (r = 0; r < MINER_H; r++)
        if ((int)strlen(MINER_ART[r]) != MINER_W)
            return 0;
    return 1;
}

/* Placement constants must leave a cone wide enough to actually put
 * gems in, otherwise a level would come up empty. */
static int tuning_ok(void)
{
    if (REACH_MARGIN <= 0.0) return 0;
    if (SWING_AMP - REACH_MARGIN <= 0.0) return 0;
    return 1;
}

/* Object tables must stay in step with the enum; a mismatch would
 * draw the wrong glyph or read past the end of a table. */
static int tables_ok(void)
{
    int i;
    for (i = 0; i < TYPE_COUNT; i++) {
        if (OBJ_COLOR[i] <= COL_BG || OBJ_COLOR[i] >= COL_COUNT) return 0;
        if (OBJ_VALUE[i] <= 0) return 0;
        if (OBJ_WEIGHT[i] <= 0.0) return 0;
        if (OBJ_GLYPH[i] == ' ' || OBJ_GLYPH[i] == '\0') return 0;
    }
    return 1;
}

/* =================================================================
 *  Main
 * ================================================================= */
int main(void)
{
    HANDLE    out = GetStdHandle(STD_OUTPUT_HANDLE);
    ULONGLONG last;
    int       inited = 0;

    if (!sprites_ok() || !tables_ok() || !tuning_ok()) {
        printf("Startup self-check failed: sprite, table or tuning mismatch.\n");
        return 1;
    }

    if (!enable_vt(out)) {
        printf("This console does not support ANSI escape sequences.\n");
        return 1;
    }

    SetConsoleTitleA("Pixel Gold Miner");
    show_cursor(out, 0);
    fputs("\x1b[2J\x1b[H", stdout);

    srand((unsigned)GetTickCount64());
    last = GetTickCount64();

    for (;;) {
        ULONGLONG now;
        double    dt;
        int       esc, restart, drop;

        if (!sync_size(out)) {
            fputs("\x1b[2J\x1b[H\x1b[38;2;255;90;90m"
                  "Please enlarge the window to at least 40x18 cells."
                  "\x1b[0m", stdout);
            fflush(stdout);
            Sleep(200);
            last = GetTickCount64();
            continue;
        }

        /* reset_game needs g_cols/g_rows/origin, so it can only run
         * once the first successful sync_size has told us the size. */
        if (!inited) {
            recompute_origin();
            reset_game();
            inited = 1;
        }

        now  = GetTickCount64();
        dt   = (double)(now - last) / 1000.0;
        last = now;
        if (dt > MAX_DT) dt = MAX_DT;   /* clamp after a stall: keeps the
                                         * hook from skipping past a gem
                                         * in a single step */

        esc     = key_pressed(VK_ESCAPE);
        restart = key_pressed('R');
        drop    = key_pressed(VK_SPACE) || key_pressed(VK_DOWN);

        if (esc)
            break;
        if (g_state == STATE_OVER && restart) {
            recompute_origin();
            reset_game();
        }

        if (g_state == STATE_PLAY) {
            if (drop && g_hook.state == HOOK_SWING)
                g_hook.state = HOOK_SHOOT;
            update(dt);
        }

        render();
        flush_frame();
        Sleep(FRAME_MS);
    }

    fputs("\x1b[0m\x1b[2J\x1b[H", stdout);   /* reset colour, clear screen */
    fflush(stdout);
    show_cursor(out, 1);

    printf("Thanks for playing!  Final score: %d\n", (int)g_score);

    free(g_glyph); free(g_col); free(g_out);
    return 0;
}
